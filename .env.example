# ==============================================================================
# Environment Configuration Template
# ==============================================================================

# Cluster Configuration
KUBECONFIG=~/.kube/config
K8S_NAMESPACE=proactive-system
SCHEDULER_NAME=proactive-scheduler

# Prometheus Configuration
PROMETHEUS_URL=http://localhost:9090
PROMETHEUS_CLUSTER_URL=http://prometheus.proactive-system.svc.cluster.local:9090
METRICS_COLLECTION_INTERVAL=10

# Model Paths & Forecast Weights
MODEL_DIR=./models
LSTM_MODEL_PATH=./models/lstm/lstm_workload_model
XGBOOST_MODEL_PATH=./models/xgboost/xgb_workload_model.json
LSTM_WEIGHT=0.60
XGBOOST_WEIGHT=0.40

# Node Ranking Weights (Sum to 1.0)
CPU_WEIGHT=0.30
MEMORY_WEIGHT=0.25
LATENCY_WEIGHT=0.20
BALANCE_WEIGHT=0.25

# Service & Monitoring
FORECAST_API_HOST=0.0.0.0
FORECAST_API_PORT=8000
METRICS_EXPORTER_PORT=8001
SLO_LATENCY_MS=500.0

# Logging
LOG_LEVEL=INFO
